# Copy to .env.local and fill in real values before launch.

# Fallback WhatsApp number, E.164 format without "+" (e.g. 12425551234).
# The real number should be set in the CMS (Site Settings > WhatsApp Number)
# instead — this is only used if that field is empty or the CMS is unreachable.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Production site URL, used for canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.islandsol.com

# --- Wix Headless (connected) ---
# The ISLAND SOL Wix Headless project's public OAuth client ID and meta
# site ID. Both are non-secret identifiers (no client secret is used
# anywhere in this app — see src/lib/wix/client.ts), but are still
# environment-configurable in case this ever points at a different Wix
# project (e.g. staging vs. production). Safe defaults matching the real
# ISLAND SOL project are baked into the code, so these are optional.
# WIX_CLIENT_ID=0fa24b6e-cf58-4cef-9e21-2a547b02062a
# WIX_META_SITE_ID=68b3cc37-d334-4f01-88d2-f1dbed413058
